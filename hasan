<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MPI Bahasa Arab - Ta'aruf</title>
    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Amiri:ital,wght@0,400;0,700;1,400&family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        sans: ['Inter', 'sans-serif'],
                        arabic: ['Amiri', 'serif'],
                    },
                    colors: {
                        emerald: {
                            50: '#ecfdf5',
                            100: '#d1fae5',
                            500: '#10b981',
                            600: '#059669',
                            700: '#047857',
                            800: '#065f46',
                            900: '#064e3b',
                        },
                        gold: {
                            400: '#fbbf24',
                            500: '#f59e0b',
                            600: '#d97706',
                        }
                    },
                    animation: {
                        'float': 'float 3s ease-in-out infinite',
                        'fade-in': 'fadeIn 0.5s ease-out forwards',
                        'slide-up': 'slideUp 0.5s ease-out forwards',
                        'pulse-slow': 'pulse 3s cubic-bezier(0.4, 0, 0.6, 1) infinite',
                    },
                    keyframes: {
                        float: {
                            '0%, 100%': { transform: 'translateY(0)' },
                            '50%': { transform: 'translateY(-10px)' },
                        },
                        fadeIn: {
                            '0%': { opacity: '0' },
                            '100%': { opacity: '1' },
                        },
                        slideUp: {
                            '0%': { opacity: '0', transform: 'translateY(20px)' },
                            '100%': { opacity: '1', transform: 'translateY(0)' },
                        }
                    }
                }
            }
        }
    </script>
    <!-- html2pdf -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/html2pdf.js/0.10.1/html2pdf.bundle.min.js"></script>
    
    <style>
        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #ecfdf5; border-radius: 4px; }
        ::-webkit-scrollbar-thumb { background: #059669; border-radius: 4px; }
        ::-webkit-scrollbar-thumb:hover { background: #047857; }
        
        .glass-panel {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.3);
        }
        
        .arabic-text {
            direction: rtl;
            line-height: 2.2;
        }

        .screen { display: none; }
        .screen.active { display: flex; animation: fadeIn 0.5s ease-out; }

        /* Hide radio inputs for custom styling */
        input[type="radio"].hidden-radio { display: none; }
        input[type="radio"].hidden-radio:checked + label {
            background-color: #d1fae5;
            border-color: #10b981;
            color: #064e3b;
        }

        @media print {
            .no-print { display: none !important; }
            body { background: white; }
            .print-container { padding: 0; margin: 0; box-shadow: none; }
        }
    </style>
</head>
<body class="bg-gradient-to-br from-emerald-50 to-emerald-200 min-h-screen text-slate-800 antialiased overflow-x-hidden selection:bg-emerald-300 selection:text-emerald-900">

    <!-- Global Modal Overlay (Reusable) -->
    <div id="globalModal" class="fixed inset-0 z-50 hidden flex-col items-center justify-center p-4 bg-slate-900/60 backdrop-blur-sm transition-opacity">
        <div id="modalContent" class="bg-white rounded-2xl shadow-2xl max-w-lg w-full max-h-[90vh] overflow-y-auto transform scale-95 transition-transform duration-300">
            <!-- Content injected here -->
        </div>
    </div>

    <!-- Alert Modal (Replaces window.alert) -->
    <div id="alertModal" class="fixed inset-0 z-[60] hidden flex-col items-center justify-center p-4 bg-slate-900/40 backdrop-blur-sm">
        <div class="bg-white rounded-xl shadow-xl p-6 max-w-sm w-full text-center">
            <div id="alertIcon" class="mb-4 text-amber-500">
                <svg class="w-12 h-12 mx-auto" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
            </div>
            <h3 id="alertTitle" class="text-lg font-bold text-slate-800 mb-2">Perhatian</h3>
            <p id="alertMessage" class="text-slate-600 mb-6"></p>
            <button onclick="closeAlert()" class="bg-emerald-600 hover:bg-emerald-700 text-white font-semibold py-2 px-6 rounded-lg transition-colors">Mengerti</button>
        </div>
    </div>

    <!-- 1. SPLASH SCREEN -->
    <div id="screen-splash" class="screen active min-h-screen flex-col items-center justify-center bg-gradient-to-b from-emerald-700 to-emerald-900 text-white">
        <div class="animate-float text-center">
            <div class="w-32 h-32 bg-white/10 rounded-full flex items-center justify-center mx-auto mb-6 backdrop-blur-md border border-white/20">
                <svg class="w-16 h-16 text-gold-400" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
                </svg>
            </div>
            <h1 class="text-4xl font-arabic font-bold mb-2">التَّعَارُف</h1>
            <h2 class="text-xl font-medium tracking-wider text-emerald-100 uppercase">Media Pembelajaran Interaktif</h2>
            <div class="mt-8 flex justify-center space-x-2">
                <div class="w-3 h-3 bg-gold-400 rounded-full animate-bounce" style="animation-delay: 0s"></div>
                <div class="w-3 h-3 bg-gold-400 rounded-full animate-bounce" style="animation-delay: 0.2s"></div>
                <div class="w-3 h-3 bg-gold-400 rounded-full animate-bounce" style="animation-delay: 0.4s"></div>
            </div>
        </div>
    </div>

    <!-- 2. COVER PAGE -->
    <div id="screen-cover" class="screen min-h-screen flex-col items-center justify-center relative py-10 px-4 bg-[url('https://www.transparenttextures.com/patterns/arabesque.png')]">
        <div class="absolute inset-0 bg-gradient-to-b from-emerald-800/90 to-emerald-900/90 z-0"></div>
        
        <div class="z-10 w-full max-w-4xl flex flex-col items-center">
            <!-- Badge -->
            <div class="bg-gold-500 text-emerald-900 text-xs sm:text-sm font-bold px-4 py-1.5 rounded-full mb-6 uppercase tracking-widest shadow-lg animate-slide-up" style="animation-delay: 0.1s;">
                Bahasa Arab • MTs Kelas VII • Fase D
            </div>

            <!-- Title -->
            <h1 class="text-2xl sm:text-3xl md:text-4xl text-center font-bold text-white mb-4 leading-snug animate-slide-up" style="animation-delay: 0.2s;">
                Kosa Kata, Pola Kalimat, dan Wacana tentang: <span class="text-gold-400 font-arabic text-4xl sm:text-5xl ml-2">التَّعَارُف</span>
            </h1>
            
            <p class="text-emerald-100 text-center text-sm sm:text-base mb-8 max-w-2xl animate-slide-up" style="animation-delay: 0.3s;">
                (مَن هُوَ؟ - مَنْ هِيَ؟ - مِنْ أَيْنَ أَنْتَ؟ - أَنَا تِلْمِيْذ – هِي مُدَرِّسَة – نَحْن - الْاِسْتِفْهَام بِ مَا/ مَن/ هَل/ مِنْ أَيْن/ كَيْف)
            </p>

            <!-- Visual Interaktif SVG -->
            <div class="w-64 h-64 sm:w-80 sm:h-80 relative mb-10 animate-float">
                <svg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg" class="w-full h-full drop-shadow-2xl">
                    <defs>
                        <linearGradient id="grad1" x1="0%" y1="0%" x2="100%" y2="100%">
                            <stop offset="0%" style="stop-color:#34d399;stop-opacity:1" />
                            <stop offset="100%" style="stop-color:#065f46;stop-opacity:1" />
                        </linearGradient>
                    </defs>
                    <circle cx="100" cy="100" r="95" fill="url(#grad1)" />
                    <path d="M 60 140 C 60 110, 140 110, 140 140" fill="none" stroke="#fbbf24" stroke-width="8" stroke-linecap="round"/>
                    <circle cx="75" cy="85" r="12" fill="#fbbf24" />
                    <circle cx="125" cy="85" r="12" fill="#fbbf24" />
                    <path d="M 100 100 L 100 120" stroke="#fff" stroke-width="4" stroke-linecap="round"/>
                    <!-- Chat bubbles -->
                    <path d="M 40 60 Q 20 60 20 40 Q 20 20 50 20 Q 80 20 80 40 Q 80 60 50 60 L 40 70 Z" fill="#fff" opacity="0.9"/>
                    <text x="35" y="45" font-family="Arial" font-size="14" fill="#065f46">أَهْلًا</text>
                    
                    <path d="M 160 70 Q 180 70 180 50 Q 180 30 150 30 Q 120 30 120 50 Q 120 70 150 70 L 160 80 Z" fill="#fff" opacity="0.9"/>
                    <text x="135" y="55" font-family="Arial" font-size="14" fill="#065f46">مَرْحَبًا</text>
                </svg>
            </div>

            <!-- Action Buttons -->
            <div class="flex flex-col sm:flex-row gap-4 w-full sm:w-auto px-4 animate-slide-up" style="animation-delay: 0.5s;">
                <button onclick="showDeveloperInfo()" class="bg-emerald-700/50 hover:bg-emerald-600 border border-emerald-400/50 text-white py-3 px-6 rounded-xl font-medium transition-all backdrop-blur-sm flex items-center justify-center gap-2">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                    Pengembang
                </button>
                <button onclick="showTujuanPembelajaran()" class="bg-emerald-700/50 hover:bg-emerald-600 border border-emerald-400/50 text-white py-3 px-6 rounded-xl font-medium transition-all backdrop-blur-sm flex items-center justify-center gap-2">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    Tujuan
                </button>
                <button onclick="navTo('screen-form')" class="bg-gold-500 hover:bg-gold-400 text-emerald-900 py-3 px-10 rounded-xl font-bold transition-all shadow-[0_0_15px_rgba(251,191,36,0.5)] hover:shadow-[0_0_25px_rgba(251,191,36,0.8)] text-lg flex items-center justify-center gap-2 sm:ml-2">
                    MULAI
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 5l7 7-7 7M5 5l7 7-7 7"></path></svg>
                </button>
            </div>
        </div>
    </div>

    <!-- 3. FORM IDENTITAS -->
    <div id="screen-form" class="screen min-h-screen flex-col items-center justify-center p-4 relative">
        <div class="absolute inset-0 bg-emerald-900/5 pattern-dots z-0"></div>
        <div class="glass-panel p-8 rounded-2xl w-full max-w-md z-10 shadow-xl border-t-4 border-t-emerald-500 relative overflow-hidden">
            <!-- Decorative circle -->
            <div class="absolute -top-16 -right-16 w-32 h-32 bg-emerald-500 rounded-full opacity-20"></div>
            
            <div class="text-center mb-8">
                <div class="inline-flex items-center justify-center w-16 h-16 rounded-full bg-emerald-100 text-emerald-600 mb-4">
                    <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
                </div>
                <h2 class="text-2xl font-bold text-slate-800">Identitas Siswa</h2>
                <p class="text-sm text-slate-500 mt-1">Silakan isi data diri untuk memulai belajar</p>
            </div>
            
            <div class="space-y-5">
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Nama Lengkap</label>
                    <input type="text" id="studentName" class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none transition-all bg-white/50" placeholder="Masukkan nama...">
                </div>
                <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Kelas</label>
                    <select id="studentClass" class="w-full px-4 py-3 rounded-xl border border-slate-300 focus:ring-2 focus:ring-emerald-500 focus:border-emerald-500 outline-none transition-all bg-white/50 appearance-none">
                        <option value="">Pilih Kelas...</option>
                        <option value="VII-A">VII-A</option>
                        <option value="VII-B">VII-B</option>
                        <option value="VII-C">VII-C</option>
                    </select>
                </div>
                <button onclick="submitForm()" class="w-full bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-3.5 rounded-xl transition-all shadow-md mt-4 flex justify-center items-center gap-2">
                    Lanjutkan
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                </button>
            </div>
        </div>
    </div>

    <!-- 4. PENGANTAR & PANDUAN -->
    <div id="screen-guide" class="screen min-h-screen flex-col items-center justify-center p-4 bg-emerald-800 text-white relative overflow-hidden">
        <div class="absolute top-[-10%] left-[-10%] w-96 h-96 bg-emerald-600 rounded-full mix-blend-multiply filter blur-3xl opacity-50"></div>
        <div class="absolute bottom-[-10%] right-[-10%] w-96 h-96 bg-gold-600 rounded-full mix-blend-multiply filter blur-3xl opacity-30"></div>

        <div class="w-full max-w-2xl z-10">
            <div id="guide-slider" class="bg-white/10 backdrop-blur-lg rounded-3xl p-8 border border-white/20 shadow-2xl relative min-h-[400px] flex flex-col">
                <div class="flex justify-between items-center mb-6">
                    <span class="text-emerald-200 text-sm font-medium tracking-wider uppercase">Panduan Penggunaan</span>
                    <div class="flex gap-1" id="guide-dots">
                        <!-- Dots injected by JS -->
                    </div>
                </div>
                
                <div id="guide-content" class="flex-grow flex flex-col justify-center text-center">
                    <!-- Slide content injected by JS -->
                </div>

                <div class="flex justify-between mt-8 pt-6 border-t border-white/10">
                    <button id="btn-guide-prev" onclick="changeGuideSlide(-1)" class="px-6 py-2 rounded-lg bg-white/5 hover:bg-white/10 text-white transition-colors invisible">Kembali</button>
                    <button id="btn-guide-next" onclick="changeGuideSlide(1)" class="px-6 py-2 rounded-lg bg-gold-500 hover:bg-gold-400 text-emerald-900 font-bold transition-colors">Selanjutnya</button>
                </div>
            </div>
        </div>
    </div>

    <!-- 5. MENU UTAMA (DASHBOARD) -->
    <div id="screen-dashboard" class="screen min-h-screen flex-col bg-slate-50">
        <!-- Header -->
        <header class="bg-emerald-700 text-white shadow-md rounded-b-3xl relative z-10 pb-10 pt-6 px-4">
            <div class="max-w-4xl mx-auto flex justify-between items-center">
                <div>
                    <h1 class="text-2xl font-bold font-arabic">مَرْحَبًا</h1>
                    <p class="text-emerald-100 text-sm">Selamat Belajar,</p>
                    <p id="dash-student-name" class="text-xl font-bold text-gold-400 capitalize">Siswa</p>
                    <p id="dash-student-class" class="text-xs text-emerald-200 mt-1 bg-emerald-800/50 inline-block px-2 py-0.5 rounded">Kelas</p>
                </div>
                <div class="w-16 h-16 bg-white/20 rounded-full flex items-center justify-center backdrop-blur-sm border-2 border-emerald-400">
                    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                </div>
            </div>
        </header>

        <!-- Main Content -->
        <main class="flex-grow max-w-4xl w-full mx-auto p-4 -mt-6 relative z-20">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <!-- Menu Belajar -->
                <div onclick="openMenu('belajar')" class="bg-white rounded-2xl p-6 shadow-lg border border-slate-100 cursor-pointer transform hover:-translate-y-1 transition-all group relative overflow-hidden">
                    <div class="absolute top-0 right-0 w-24 h-24 bg-emerald-100 rounded-bl-full -mr-4 -mt-4 transition-transform group-hover:scale-110"></div>
                    <div class="w-14 h-14 bg-emerald-500 rounded-xl flex items-center justify-center text-white mb-4 relative z-10 shadow-md">
                        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
                    </div>
                    <h3 class="text-xl font-bold text-slate-800 relative z-10">BELAJAR</h3>
                    <p class="text-sm text-slate-500 mt-2 relative z-10">8 Materi Mendalam</p>
                    <div class="mt-4 flex items-center text-emerald-600 text-sm font-semibold">
                        <span id="status-belajar">Terbuka 🔓</span>
                    </div>
                    <!-- Progress Bar -->
                    <div class="w-full bg-slate-200 rounded-full h-1.5 mt-4">
                        <div id="prog-belajar" class="bg-emerald-500 h-1.5 rounded-full transition-all duration-500" style="width: 0%"></div>
                    </div>
                </div>

                <!-- Menu Bermain -->
                <div onclick="openMenu('bermain')" class="bg-white rounded-2xl p-6 shadow-lg border border-slate-100 cursor-pointer transform hover:-translate-y-1 transition-all group relative overflow-hidden" id="card-bermain">
                    <div class="absolute top-0 right-0 w-24 h-24 bg-amber-100 rounded-bl-full -mr-4 -mt-4 transition-transform group-hover:scale-110"></div>
                    <div class="w-14 h-14 bg-slate-300 rounded-xl flex items-center justify-center text-white mb-4 relative z-10 shadow-md" id="icon-bermain">
                        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    </div>
                    <h3 class="text-xl font-bold text-slate-800 relative z-10">BERMAIN</h3>
                    <p class="text-sm text-slate-500 mt-2 relative z-10">10 Tantangan Interaktif</p>
                    <div class="mt-4 flex items-center text-slate-400 text-sm font-semibold" id="status-text-bermain">
                        <span>Terkunci 🔒</span>
                    </div>
                </div>

                <!-- Menu Berlatih -->
                <div onclick="openMenu('berlatih')" class="bg-white rounded-2xl p-6 shadow-lg border border-slate-100 cursor-pointer transform hover:-translate-y-1 transition-all group relative overflow-hidden" id="card-berlatih">
                    <div class="absolute top-0 right-0 w-24 h-24 bg-rose-100 rounded-bl-full -mr-4 -mt-4 transition-transform group-hover:scale-110"></div>
                    <div class="w-14 h-14 bg-slate-300 rounded-xl flex items-center justify-center text-white mb-4 relative z-10 shadow-md" id="icon-berlatih">
                        <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                    </div>
                    <h3 class="text-xl font-bold text-slate-800 relative z-10">BERLATIH</h3>
                    <p class="text-sm text-slate-500 mt-2 relative z-10">Asesmen Berjenjang</p>
                    <div class="mt-4 flex items-center text-slate-400 text-sm font-semibold" id="status-text-berlatih">
                        <span>Terkunci 🔒</span>
                    </div>
                </div>
            </div>
            
            <!-- Motivasi Banner -->
            <div class="mt-8 bg-gradient-to-r from-emerald-50 to-emerald-100 border border-emerald-200 rounded-2xl p-5 flex items-start gap-4">
                <div class="text-3xl">🌱</div>
                <div>
                    <h4 class="font-bold text-emerald-800">Kurikulum Berbasis Cinta</h4>
                    <p class="text-sm text-emerald-700 mt-1 leading-relaxed">
                        "Belajarlah untuk saling mengenal (Ta'aruf), karena dari mengenal akan tumbuh rasa kasih sayang kepada sesama makhluk Allah, menjaga alam Pohuwato kita, dan menggapai rida-Nya."
                    </p>
                </div>
            </div>
        </main>
    </div>

    <!-- 6. LAYER BELAJAR (8 SLIDES) -->
    <div id="screen-belajar" class="screen min-h-screen flex-col bg-slate-50 relative">
        <header class="bg-white border-b border-slate-200 sticky top-0 z-30 px-4 py-3 flex justify-between items-center shadow-sm">
            <div class="flex items-center gap-3">
                <button onclick="navTo('screen-dashboard')" class="p-2 rounded-full hover:bg-slate-100 text-slate-600 transition-colors">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                </button>
                <div>
                    <h2 class="font-bold text-slate-800">Modul Belajar</h2>
                    <p class="text-xs text-emerald-600 font-medium">Slide <span id="belajar-current">1</span> / 8</p>
                </div>
            </div>
            <div class="flex gap-1" id="belajar-indicators">
                <!-- Indicators -->
            </div>
        </header>

        <main class="flex-grow w-full max-w-3xl mx-auto p-4 pb-24">
