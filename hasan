                                    <input type="radio" name="b_chal" id="b_chal_${idx}" value="${idx}" class="hidden-radio" ${belajarStatus[currentBelajar] ? 'disabled' : ''}>
                                    <label for="b_chal_${idx}" class="block w-full p-4 border-2 border-amber-100 rounded-lg cursor-pointer hover:bg-amber-100/50 transition-colors ${belajarStatus[currentBelajar] ? 'opacity-50 cursor-not-allowed' : ''}">
                                        ${opt}
                                    </label>
                                </div>
                            `).join('')}
                         </div>
                         <div id="b_chal_feedback" class="mt-4 hidden font-bold text-sm"></div>
                    </div>
                </div>
            `;
            document.getElementById('belajar-content').innerHTML = contentHTML;
            
            if(!belajarStatus[currentBelajar]) {
                document.querySelectorAll('input[name="b_chal"]').forEach(radio => {
                    radio.addEventListener('change', (e) => {
                        checkBelajarChallenge(parseInt(e.target.value));
                    });
                });
            } else {
                 updateBelajarBottomNav(true);
                 const correctInput = document.getElementById(`b_chal_${data.challenge.answer}`);
                 if(correctInput) correctInput.checked = true;
            }

            dataBelajar.forEach((_, i) => {
                const dot = document.getElementById(`b-dot-${i}`);
                if(i === currentBelajar) {
                    dot.classList.replace('bg-slate-200', 'bg-emerald-500');
                    dot.classList.add('w-4');
                } else {
                    dot.classList.replace('bg-emerald-500', 'bg-slate-200');
                    dot.classList.remove('w-4');
                    if(belajarStatus[i]) dot.classList.replace('bg-slate-200', 'bg-emerald-300'); 
                }
            });

            document.getElementById('btn-belajar-prev').style.visibility = currentBelajar === 0 ? 'hidden' : 'visible';
            updateBelajarBottomNav(belajarStatus[currentBelajar]);
        }

        function checkBelajarChallenge(selectedIndex) {
            const data = dataBelajar[currentBelajar];
            const feedback = document.getElementById('b_chal_feedback');
            
            if(selectedIndex === data.challenge.answer) {
                feedback.innerHTML = '<span class="text-emerald-600 flex items-center gap-1"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Jawaban Benar! Anda dapat melanjutkan.</span>';
                feedback.classList.remove('hidden');
                belajarStatus[currentBelajar] = true;
                
                document.querySelectorAll('label[for^="b_chal_"]').forEach(lbl => lbl.classList.add('opacity-50', 'cursor-not-allowed'));
                
                updateBelajarBottomNav(true);
                updateBelajarProgress();
            } else {
                feedback.innerHTML = '<span class="text-rose-600 flex items-center gap-1"><svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg> Jawaban kurang tepat, silakan coba lagi.</span>';
                feedback.classList.remove('hidden');
                document.querySelectorAll('input[name="b_chal"]').forEach(r => r.checked = false);
            }
        }

        function updateBelajarBottomNav(isComplete) {
            const btnNext = document.getElementById('btn-belajar-next');
            const statusBox = document.getElementById('belajar-challenge-status');
            
            if(isComplete) {
                statusBox.innerHTML = '<span class="text-emerald-600 flex items-center gap-1"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg> Selesai</span>';
                btnNext.classList.remove('opacity-50', 'cursor-not-allowed');
                
                if(currentBelajar === dataBelajar.length - 1) {
                    btnNext.innerText = "Selesaikan Materi";
                    btnNext.classList.replace('bg-emerald-500', 'bg-gold-500');
                    btnNext.classList.replace('hover:bg-emerald-600', 'hover:bg-gold-400');
                    btnNext.classList.replace('text-white', 'text-emerald-900');
                } else {
                    btnNext.innerHTML = 'Lanjut <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>';
                     btnNext.classList.replace('bg-gold-500', 'bg-emerald-500');
                     btnNext.classList.add('text-white');
                }
            } else {
                statusBox.innerHTML = '<svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> Selesaikan aktivitas';
                btnNext.classList.add('opacity-50', 'cursor-not-allowed');
            }
        }

        function updateBelajarProgress() {
            const completed = belajarStatus.filter(Boolean).length;
            const pct = (completed / 8) * 100;
            document.getElementById('prog-belajar').style.width = `${pct}%`;
            
            if(completed === 8) {
                state.progress.belajarComplete = true;
                document.getElementById('status-belajar').innerHTML = 'Selesai <svg class="w-4 h-4 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>';
            }
        }

        function changeBelajarSlide(dir) {
            if (dir === 1 && !belajarStatus[currentBelajar]) return;
            if (dir === 1 && currentBelajar === dataBelajar.length - 1) {
                showAlert("Alhamdulillah!", "Anda telah menyelesaikan seluruh materi belajar. Menu BERMAIN kini telah terbuka.");
                navTo('screen-dashboard');
                updateDashboardLocks();
                return;
            }
            currentBelajar += dir;
            renderBelajarSlide();
        }

        /* === BERMAIN LOGIC === */
        let currentBermain = 0;
        let scoreBermain = 0;

        function initBermain() {
            currentBermain = 0;
            scoreBermain = 0;
            updateBermainScoreDisplay();
            renderBermainChallenge();
        }

        function renderBermainChallenge() {
            const data = dataBermain[currentBermain];
            document.getElementById('bermain-current').innerText = currentBermain + 1;
            document.getElementById('prog-bermain').style.width = `${((currentBermain+1)/10)*100}%`;
            
            const content = `
                <div class="bg-white rounded-2xl p-6 shadow-sm border border-amber-200 animate-slideUp">
                    <div class="mb-6 bg-slate-50 p-5 rounded-xl border border-slate-100 text-slate-700 text-sm leading-relaxed text-justify">
                        <span class="font-bold text-amber-700 block mb-2 uppercase text-xs tracking-wider">Stimulus Literasi</span>
                        ${data.stimulus}
                    </div>
                    
                    <h3 class="font-bold text-lg text-slate-800 mb-6">${data.question}</h3>
                    
                    <div class="space-y-3" id="bermain-options">
                        ${data.options.map((opt, idx) => `
                            <button onclick="handleBermainAnswer(${idx})" class="w-full text-left p-4 border-2 border-slate-200 rounded-xl hover:border-amber-400 hover:bg-amber-50 transition-all font-medium text-slate-700 focus:outline-none focus:ring-4 focus:ring-amber-100 bg-white">
                                ${opt}
                            </button>
                        `).join('')}
                    </div>
                </div>
            `;
            document.getElementById('bermain-content').innerHTML = content;
        }

        function handleBermainAnswer(selectedIndex) {
            const data = dataBermain[currentBermain];
            const isCorrect = selectedIndex === data.answer;
            const buttons = document.getElementById('bermain-options').querySelectorAll('button');
            
            buttons.forEach(b => b.disabled = true);
            
            // Simpan detail jawaban siswa untuk sinkronisasi Google Sheets
            state.jawabanBermain[currentBermain] = {
                soal: data.question,
                jawabanSiswa: data.options[selectedIndex],
                isBenar: isCorrect
            };
            
            if(isCorrect) {
                buttons[selectedIndex].classList.replace('border-slate-200', 'border-emerald-500');
                buttons[selectedIndex].classList.replace('bg-white', 'bg-emerald-50');
                buttons[selectedIndex].innerHTML += ' <span class="float-right text-emerald-600">✅ Benar! (+10)</span>';
                scoreBermain += 10;
                updateBermainScoreDisplay();
            } else {
                buttons[selectedIndex].classList.replace('border-slate-200', 'border-rose-500');
                buttons[selectedIndex].classList.replace('bg-white', 'bg-rose-50');
                buttons[selectedIndex].innerHTML += ' <span class="float-right text-rose-600">❌ Salah</span>';
                
                buttons[data.answer].classList.replace('border-slate-200', 'border-emerald-500');
                buttons[data.answer].classList.add('bg-emerald-50');
            }

            setTimeout(() => {
                if(currentBermain < 9) {
                    currentBermain++;
                    renderBermainChallenge();
                } else {
                    finishBermain();
                }
            }, 1500);
        }

        function updateBermainScoreDisplay() {
            document.getElementById('bermain-score').innerText = scoreBermain;
        }

        function finishBermain() {
            state.scores.bermain = scoreBermain;
            state.progress.bermainComplete = true;
            
            const msg = scoreBermain >= 70 ? "Luar Biasa!" : "Tetap Semangat!";
            
            showModal(`
                <div class="p-8 text-center bg-amber-50 rounded-2xl border-4 border-amber-200">
                    <div class="text-6xl mb-4">🎮</div>
                    <h2 class="text-3xl font-bold text-amber-800 mb-2">${msg}</h2>
                    <p class="text-slate-600 mb-6">Anda telah menyelesaikan sesi Bermain.</p>
                    <div class="bg-white rounded-xl p-4 inline-block mb-6 shadow-sm border border-amber-100">
                        <span class="block text-sm text-amber-600 font-bold uppercase mb-1">Skor Anda</span>
                        <span class="text-4xl font-bold text-slate-800">${scoreBermain} <span class="text-lg">/ 100</span></span>
                    </div>
                    <p class="text-sm text-emerald-700 font-medium mb-6">✨ Menu BERLATIH (Asesmen) kini telah terbuka!</p>
                    <button onclick="navTo('screen-dashboard'); closeModal(); updateDashboardLocks();" class="w-full bg-amber-500 hover:bg-amber-600 text-white font-bold py-3 rounded-xl transition-colors shadow-md">
                        Kembali ke Dashboard
                    </button>
                </div>
            `);
        }

        /* === BERLATIH LOGIC === */
        let currentBerlatih = 0;
        let jawabanBerlatihArr = Array(10).fill(null);

        function initBerlatih() {
            currentBerlatih = 0;
            jawabanBerlatihArr = Array(10).fill(null);
            
            const prog = document.querySelector('#screen-berlatih .w-full.bg-slate-200');
            prog.innerHTML = dataBerlatih.map((_, i) => `<div id="latih-seg-${i}" class="flex-1 h-1.5 rounded-full bg-slate-300 transition-colors"></div>`).join('');
            
            renderBerlatihQuestion();
        }

        function renderBerlatihQuestion() {
            const data = dataBerlatih[currentBerlatih];
            document.getElementById('berlatih-current').innerText = currentBerlatih + 1;
            
            const badge = document.getElementById('berlatih-badge');
            if(data.level === 1) { badge.className = "px-3 py-1 rounded-full text-xs font-bold text-white shadow-sm bg-emerald-500"; badge.innerText = "Level 1: Dasar (8 Poin)"; }
            if(data.level === 2) { badge.className = "px-3 py-1 rounded-full text-xs font-bold text-white shadow-sm bg-amber-500"; badge.innerText = "Level 2: Penerapan (10 Poin)"; }
            if(data.level === 3) { badge.className = "px-3 py-1 rounded-full text-xs font-bold text-white shadow-sm bg-rose-500"; badge.innerText = "Level 3: HOTS (12 Poin)"; }

            document.querySelectorAll('[id^="latih-seg-"]').forEach((el, idx) => {
                if(idx < currentBerlatih) el.classList.replace('bg-slate-300', 'bg-rose-400');
                else if (idx === currentBerlatih) el.classList.replace('bg-slate-300', 'bg-rose-500');
                else { el.classList.replace('bg-rose-400', 'bg-slate-300'); el.classList.replace('bg-rose-500', 'bg-slate-300'); }
            });

            const content = `
                <div class="animate-fadeIn">
                     <div class="mb-6 bg-slate-50 p-5 rounded-xl border-l-4 border-slate-400 text-slate-700 text-sm leading-relaxed text-justify">
                        <span class="font-bold text-slate-500 block mb-2 uppercase text-xs tracking-wider">Teks Stimulus</span>
                        ${data.stimulus}
                    </div>
                    
                    <h3 class="font-bold text-lg text-slate-800 mb-6 leading-snug">${currentBerlatih+1}. ${data.question}</h3>
                    
                    <div class="space-y-3">
                        ${data.options.map((opt, idx) => `
                            <div class="relative">
                                <input type="radio" name="l_ans" id="l_ans_${idx}" value="${idx}" class="hidden-radio" onchange="enableLanjutBtn()">
                                <label for="l_ans_${idx}" class="block w-full p-4 border-2 border-slate-200 rounded-xl cursor-pointer hover:border-slate-300 hover:bg-slate-50 transition-all font-medium text-slate-700 flex items-start gap-3">
                                    <span class="w-6 h-6 rounded-full border-2 border-slate-300 flex-shrink-0 flex items-center justify-center text-xs text-transparent label-circle mt-0.5">✔</span>
                                    <span class="flex-grow ${/[\u0600-\u06FF]/.test(opt) ? 'font-arabic text-xl text-right' : ''}">${opt}</span>
                                </label>
                            </div>
                        `).join('')}
                    </div>
                </div>
                <style>
                    input[type="radio"].hidden-radio:checked + label { border-color: #e11d48; background-color: #fff1f2; color: #9f1239; }
                    input[type="radio"].hidden-radio:checked + label .label-circle { border-color: #e11d48; background-color: #e11d48; color: white; }
                </style>
            `;
            document.getElementById('berlatih-content').innerHTML = content;
            
            const btn = document.getElementById('btn-berlatih-next');
            btn.classList.add('opacity-50', 'cursor-not-allowed');
            if(currentBerlatih === 9) {
                btn.innerHTML = 'Kumpulkan & Selesai <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>';
            } else {
                btn.innerHTML = 'Kirim Jawaban & Lanjut <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>';
            }
        }

        function enableLanjutBtn() {
            document.getElementById('btn-berlatih-next').classList.remove('opacity-50', 'cursor-not-allowed');
        }

        function nextBerlatih() {
            const selected = document.querySelector('input[name="l_ans"]:checked');
            if(!selected) return;

            const selectedIdx = parseInt(selected.value);
            jawabanBerlatihArr[currentBerlatih] = selectedIdx;
            
            // Simpan detail jawaban siswa untuk sinkronisasi Google Sheets
            state.jawabanBerlatih[currentBerlatih] = {
                soal: dataBerlatih[currentBerlatih].question,
                jawabanSiswa: dataBerlatih[currentBerlatih].options[selectedIdx],
                isBenar: selectedIdx === dataBerlatih[currentBerlatih].answer
            };
            
            if(currentBerlatih < 9) {
                currentBerlatih++;
                renderBerlatihQuestion();
            } else {
                calculateBerlatihScore();
            }
        }

        function calculateBerlatihScore() {
            let total = 0;
            let l1 = 0, l2 = 0, l3 = 0;
            
            dataBerlatih.forEach((q, idx) => {
                if(jawabanBerlatihArr[idx] === q.answer) {
                    total += q.points;
                    if(q.level === 1) l1++;
                    if(q.level === 2) l2++;
                    if(q.level === 3) l3++;
                }
            });

            state.scores.berlatih = total;
            state.berlatihBreakdown = { lvl1: l1, lvl2: l2, lvl3: l3 };
            state.progress.berlatihComplete = true;

            // Generate report di UI terlebih dahulu
            generateReportData();
            navTo('screen-report');
            
            // Kirim data ke Google Sheets di background
            sendDataToGAS();
        }

        /* === FUNGSI SINKRONISASI KE GOOGLE SHEETS === */
        function sendDataToGAS() {
            if(GAS_URL === "URL_GAS_ANDA_DISINI" || !GAS_URL) {
                console.warn("GAS URL belum disetting. Data tidak akan dikirim ke Spreadsheet.");
                const statusEl = document.getElementById('syncStatus');
                statusEl.innerText = "URL Server belum diatur";
                statusEl.className = "text-sm font-medium text-rose-500 block";
                return;
            }
            
            const btnDownload = document.getElementById('btnDownloadPDF');
            const statusEl = document.getElementById('syncStatus');
            const originalBtnContent = btnDownload.innerHTML;
            
            // UI Loading State
            btnDownload.innerHTML = '<svg class="w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg> Menyimpan...';
            btnDownload.disabled = true;
            statusEl.innerText = "Sinkronisasi data ke server...";
            statusEl.className = "text-sm font-medium text-amber-600 block";

            // Siapkan Payload Data
            const payload = {
                action: "saveHasil",
                name: state.student.name,
                kelas: state.student.class,
                bermainScore: state.scores.bermain,
                berlatihScore: state.scores.berlatih,
                benar: state.berlatihBreakdown.lvl1 + state.berlatihBreakdown.lvl2 + state.berlatihBreakdown.lvl3,
                salah: 10 - (state.berlatihBreakdown.lvl1 + state.berlatihBreakdown.lvl2 + state.berlatihBreakdown.lvl3),
                jawabanBermain: state.jawabanBermain,
                jawabanBerlatih: state.jawabanBerlatih,
                // Mengirimkan struktur soal agar sheet "Data Soal" terbuat secara otomatis jika belum ada
                dataBermain: dataBermain,
                dataBerlatih: dataBerlatih
            };

            // Kirim menggunakan fetch POST (plain text mode agar menghindari preflight CORS dari Google Script)
            fetch(GAS_URL, {
                method: 'POST',
                body: JSON.stringify(payload)
            })
            .then(res => res.json())
            .then(data => {
                console.log("Data berhasil disimpan:", data);
                btnDownload.innerHTML = originalBtnContent;
                btnDownload.disabled = false;
                
                statusEl.innerText = "✓ Data tersimpan";
                statusEl.className = "text-sm font-bold text-emerald-600 block";
                setTimeout(() => { statusEl.classList.add('hidden'); }, 4000);
            })
            .catch(err => {
                console.error("Gagal menyimpan data:", err);
                btnDownload.innerHTML = originalBtnContent;
                btnDownload.disabled = false;
                
                statusEl.innerText = "⚠ Gagal menyimpan (Cek koneksi/URL)";
                statusEl.className = "text-sm font-bold text-rose-600 block";
            });
        }

        /* === UTILS & REPORT === */
        function confirmExit(type) {
            const res = confirm(`Anda yakin ingin keluar dari sesi ${type}? Kemajuan saat ini akan hilang.`);
            if(res) {
                navTo('screen-dashboard');
                if(type==='berlatih') initBerlatih(); // reset
            }
        }

        function generateReportData() {
            document.getElementById('rep-name').innerText = state.student.name;
            document.getElementById('rep-class').innerText = state.student.class + " / Fase D";
            
            const date = new Date();
            document.getElementById('rep-date').innerText = `${date.getDate()} / ${date.getMonth()+1} / ${date.getFullYear()}`;
            
            document.getElementById('rep-bermain-score').innerText = state.scores.bermain;
            document.getElementById('rep-berlatih-score').innerText = state.scores.berlatih;
            
            const score = state.scores.berlatih;
            let pred = "", colorClass = "", rec = "";
            if(score >= 85) {
                pred = "SANGAT BAIK (MUMTAZ)"; colorClass = "bg-emerald-200 text-emerald-800";
                rec = "Pertahankan prestasimu! Pemahamanmu tentang Ta'aruf sangat mendalam, jadikan ini bekal untuk berinteraksi santun dalam keberagaman masyarakat Pohuwato.";
            } else if (score >= 70) {
                pred = "BAIK (JAYYID)"; colorClass = "bg-amber-200 text-amber-800";
                rec = "Bagus! Kamu sudah memahami konsep dasar dengan baik. Terus tingkatkan kemampuan analisismu pada struktur kalimat yang lebih kompleks.";
            } else {
                pred = "PERLU BIMBINGAN"; colorClass = "bg-rose-200 text-rose-800";
                rec = "Jangan menyerah. Mari ulangi lagi modul materi. Mempelajari bahasa Arab membutuhkan kesabaran. Silakan berdiskusi dengan Bapak Guru.";
            }
            
            const predEl = document.getElementById('rep-predicate');
            predEl.innerText = pred;
            predEl.className = `text-sm font-bold mt-2 inline-block px-3 py-1 rounded ${colorClass}`;
            document.getElementById('rep-recommendation').innerText = rec;

            document.getElementById('rep-lvl1').innerText = `${state.berlatihBreakdown.lvl1} / 3`;
            document.getElementById('rep-lvl2').innerText = `${state.berlatihBreakdown.lvl2} / 4`;
            document.getElementById('rep-lvl3').innerText = `${state.berlatihBreakdown.lvl3} / 3`;
        }

        function generatePDF() {
            const element = document.getElementById('printArea');
            const opt = {
                margin:       [0, 0, 0, 0], // Margin handled by CSS padding
                filename:     `Rapot_BahasaArab_${state.student.name.replace(/\s/g, '_')}.pdf`,
                image:        { type: 'jpeg', quality: 0.98 },
                html2canvas:  { scale: 2, useCORS: true, letterRendering: true },
                jsPDF:        { unit: 'in', format: 'a4', orientation: 'portrait' }
            };

            element.classList.add('p-8'); 
            
            html2pdf().set(opt).from(element).save().then(() => {
                element.classList.remove('p-8'); 
            });
        }

        // Initialize App
        window.onload = () => {
            setTimeout(() => {
                navTo('screen-cover');
            }, 2000);
        };
    </script>
</body>
</html>
